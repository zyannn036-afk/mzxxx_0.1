+  if (!insidePoly(x, z, WALL.t / 2 + 0.4 + m)) return false;
+  if (Math.hypot(x, z) < RING.r + RING.w / 2 + m) return false;
+  if (radialSigned(x, z, 108) < ROAD_W / 2 + m) return false;
+  if (radialSigned(x, z, 180) > -(ROAD_W / 2 + m)) return false;
+  return true;
