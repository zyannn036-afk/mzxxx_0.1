+// titik-titik yang harus bebas rumput / pohon / bunga / batu (dipakai meadow.js sebagai "tempat khusus"): pusat + jalan masuk
+export const D_CLEAR = [{ x: DUSUN.x, z: DUSUN.z, r: DUSUN.radius + 2 }, { x: D_PEN.x, z: D_PEN.z, r: 8 }];
