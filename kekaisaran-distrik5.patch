+  names: ['Kantor Perbendaharaan', 'Arsip Kekaisaran', 'Balai Pencatatan', 'Pengadilan Agung', 'Kantor Pos Kekaisaran', 'Kantor Pengawas'],
+  kinds: ['treasury', 'archive', 'registry', 'court', 'post', 'office'],
+};
+D5.halls = D5.ring.angles.map((deg, i) => {
