+});
+for (const b of [...D5.buildings, ...D5.halls]) { const p = d5p(b.u, b.v); b.x = p.x; b.z = p.z; b.face = d5Face(b.to[0], b.to[1]); }
+export const D5_FOOTPRINTS = [...D5.buildings, ...D5.halls].map(b => ({ x: b.x, z: b.z, w: b.w, d: b.d, face: b.face }));
